# Binance USDⓈ-M Futures Demo credentials.
# Set real credentials in Render Environment Variables only.
# Never commit API keys, secrets, private keys, or certificates.

BINANCE_DEMO_API_KEY=replace_with_demo_api_key
BINANCE_DEMO_AUTH_TYPE=rsa
BINANCE_DEMO_PRIVATE_KEY=replace_with_demo_private_key_pem
BINANCE_DEMO_BASE_URL=https://demo-fapi.binance.com

# Binance LIVE credentials: read-only diagnostic probes only.
BINANCE_LIVE_API_KEY=replace_with_live_api_key
BINANCE_LIVE_AUTH_TYPE=hmac
BINANCE_LIVE_API_SECRET=replace_with_live_api_secret
BINANCE_LIVE_PRIVATE_KEY=
BINANCE_LIVE_BASE_URL=https://fapi.binance.com

# Execution remains disabled during connectivity testing.
DEMO_EXECUTION_ENABLED=false
MAX_DEMO_ORDER_QUANTITY=0.001

# Public websocket connections (disabled by default)
BINANCE_PUBLIC_WS_ENABLED=false
BYBIT_PUBLIC_WS_ENABLED=false
DELTA_PUBLIC_WS_ENABLED=false
BYBIT_PUBLIC_SYMBOL=BTCUSDT
DELTA_PUBLIC_SYMBOL=BTCUSD
