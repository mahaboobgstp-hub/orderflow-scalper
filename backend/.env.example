# Binance USDⓈ-M Futures Demo credentials.
# Copy these settings to your private backend environment.
# Never commit real API credentials.

BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

BINANCE_DEMO_BASE_URL=https://demo-fapi.binance.com

# Keep false until the demo API connection and risk checks are tested.
DEMO_EXECUTION_ENABLED=false

# Conservative maximum quantity per submitted order.
MAX_DEMO_ORDER_QUANTITY=0.001

# Phase 2 public websocket connections (disabled by default)
BINANCE_PUBLIC_WS_ENABLED=false
BYBIT_PUBLIC_WS_ENABLED=false
DELTA_PUBLIC_WS_ENABLED=false
BYBIT_PUBLIC_SYMBOL=BTCUSDT
DELTA_PUBLIC_SYMBOL=BTCUSD
